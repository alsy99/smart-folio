# Public 30-day paper campaign is frozen (campaign/public-30d). Do not flip
# settings mid-window. Reproduce: go run ./cmd/campaign -verify
CAMPAIGN_DAYS=30
# Paper fills follow NSE 09:15–15:30 IST. Set to open only to force after-hours fills.
# MARKET_CLOCK_OVERRIDE=open
# 45s / +1.2% / −0.8% exits. Default is positional cash (days–weeks).
SCALP_MODE=false
# Dated walk-forward roster snapshots (YYYY-MM-DD.json). Boot uses the latest.
# ROSTER_DIR=data/roster
# Closed-trade ledger + weekly weights (never retrain on a single fill).
# LEARNING_DIR=data/learning
AUTOSTART_CAMPAIGN=true
EXCESS_TARGET=0.10
MAX_INVESTIGATION_WORKERS=16
INVESTIGATION_MATERIALITY_MIN=0.35
NEWS_REFRESH_SECONDS=900
INVESTIGATION_LLM=true
INVESTIGATION_LLM_MAX=5
# IST-day token bill for investigations (prompt+completion). Spent cap → heuristic.
INVESTIGATION_TOKENS_DAY=50000
# INVESTIGATION_DIR=data/investigations
NEWSAPI_KEY=
CURRENTS_API_KEY=
FINNHUB_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
ZAI_MODEL=glm-4.5-flash
# INDstocks (INDMoney) — quotes, history, Nifty option-chain PCR as tape sentiment.
# Token: INDMONEY_API_TOKEN in ~/.zshrc, or INDSTOCKS_ACCESS_TOKEN here.
# Dashboard: https://indstocks.com/app/api-trading/access-tokens
# Docs: https://api-docs.indstocks.com/api-overview/
INDSTOCKS_ACCESS_TOKEN=
# Optional TOTP token mint (do not commit). Static token above is enough.
# INDSTOCKS_API_KEY=
# INDSTOCKS_MPIN=
# INDSTOCKS_TOTP_SECRET=
# Live brokerage stays compile-time off. AUTOPILOT_LIVE_IND is ignored.
# There is no env flag that enables live routing.
AUTOPILOT_LIVE_IND=false
# Browser → gateway. Empty / unset uses this origin's /gw proxy (works on LAN
# and through a tunnel). Set only to point the desk at a gateway on another host.
# NEXT_PUBLIC_API_URL=
# Server-side rewrite target for /gw. Default http://127.0.0.1:8080
# GATEWAY_URL=http://127.0.0.1:8080
# Never put API keys in NEXT_PUBLIC_*. Secrets stay in this file / process env.
LOG_FORMAT=json
GATEWAY_RPS=40
GATEWAY_BURST=80
